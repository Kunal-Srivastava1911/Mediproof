# Copy to .env (gitignored). Never commit real keys.

# LLM (Claude). Get a key at https://console.anthropic.com — a Claude.ai chat subscription
# does not include API access.
ANTHROPIC_API_KEY=
LLM_LIVE=0                 # 1 = allow live Claude calls (and record them); 0 = replay only
LLM_BUDGET_USD=1.00        # hard cap per run; the client stops before exceeding it
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium          # low | medium | high | xhigh | max
LLM_FALLBACKS=1            # server-side refusal fallback (Claude API only)
LLM_AGENTS=1               # run the agent auditor (replays fixtures; live only if LLM_LIVE=1)

# Datagen
DATAGEN_SEED=42

# Storage
DATABASE_URL=sqlite:///./data/mediproof.db

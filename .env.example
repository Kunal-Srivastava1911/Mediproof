# Copy to .env (gitignored). Never commit real keys.

# LLM provider: gemini (free tier) or anthropic (Claude, paid API).
LLM_PROVIDER=gemini
# Gemini: free key at https://aistudio.google.com/apikey. Free-tier content may be used by
# Google to improve its products — fine for the synthetic benchmark, not for real files.
GEMINI_API_KEY=
# Claude: key at https://console.anthropic.com (a Claude.ai Pro plan does not include API use).
ANTHROPIC_API_KEY=

LLM_LIVE=0                 # 1 = allow live calls (and record them); 0 = replay only
LLM_MODEL=                 # blank = provider default (gemini-3.8-flash / claude-opus-5-5)
LLM_BUDGET_USD=1.00        # hard cap per run for paid providers (Gemini free tier books $0)
LLM_MIN_INTERVAL_S=        # blank = 6s between calls on gemini (free-tier pacing), 0 otherwise
LLM_EFFORT=medium          # Claude only: low | medium | high | xhigh | max
LLM_FALLBACKS=1            # Claude only: server-side refusal fallback
LLM_AGENTS=1               # run the agent auditor (replays fixtures; live only if LLM_LIVE=1)

# Datagen
DATAGEN_SEED=42

# Storage
DATABASE_URL=sqlite:///./data/mediproof.db
